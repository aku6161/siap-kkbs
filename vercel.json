{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/cron/backup.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/cron/daily-reminders.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 18 * * 6"
    },
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 1 * * *"
    }
  ]
}
